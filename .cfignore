# Cloudflare Pages Ignore File
# 排除不需要部署的文件，减少上传大小并避免超过 25MB 文件限制

# Next.js Cache (构建缓存，不需要部署)
.next/cache/

# Build traces (不需要运行时)
.next/trace

# Node modules (Cloudflare 会自动安装)
node_modules/

# Git
.git/
.gitignore

# Environment files
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Documentation (可选，如果想减少上传大小)
*.md
!README.md

# Scripts
deploy-to-cloudflare.sh
deploy-to-cloudflare.ps1

# TypeScript (源文件，已编译)
src/
tsconfig.json

# Development
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
